{
  "info": {
    "name": "B-Kids - Auth & Parent → Child flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tes alur register/login parent, create parent profile, register child, create child profile (by parent), link family, create child account. Sesuaikan {{base_url}}."
  },
  "item": [
    {
      "name": "00 - Environment setup (manual)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Optional: cek server hidup di {{base_url}}"
      }
    },
    {
      "name": "01 - Register Parent (AUTH)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{parent_email}}\",\"password\":\"{{parent_password}}\",\"role\":\"PARENT\"}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth","register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register parent returns 201 or 200', function () {",
              "  pm.response.to.be.ok;",
              "});",
              "// capture user id if present",
              "try {",
              "  const json = pm.response.json();",
              "  if (json.data && json.data.userId) pm.environment.set('parent_user_id', json.data.userId);",
              "  if (json.data && json.data.email) pm.environment.set('parent_email', json.data.email);",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Login Parent (AUTH)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{parent_email}}\",\"password\":\"{{parent_password}}\"}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login success and token returned', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('data');",
              "  pm.expect(json.data).to.have.property('accessToken');",
              "});",
              "const json = pm.response.json();",
              "if (json && json.data && json.data.accessToken) {",
              "  pm.environment.set('parent_jwt', json.data.accessToken);",
              "  // optional: store profile id if returned",
              "  if (json.data.profileId) pm.environment.set('parent_profile_id', json.data.profileId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Create Parent Profile",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{parent_jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Budi Santoso\",\n  \"nik\": \"3201010101010001\",\n  \"dateOfBirth\": \"1985-05-10\",\n  \"bsiAccountNumber\": \"1234567890\"\n}"
        },
        "url": { "raw": "{{base_url}}/parents", "host": ["{{base_url}}"], "path": ["parents"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create parent profile success', function () { pm.response.to.have.status(201); });",
              "try { const json = pm.response.json(); if (json.data && json.data.id) pm.environment.set('parent_profile_id', json.data.id); } catch(e){}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 - Register Child (AUTH)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{child_email}}\",\"password\":\"{{child_password}}\",\"role\":\"CHILD\"}"
        },
        "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register child ok', function () { pm.response.to.be.ok; });",
              "try { const json = pm.response.json(); if (json.data && json.data.userId) pm.environment.set('child_user_id', json.data.userId); } catch(e){}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 - Create Child Profile (by Parent)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{parent_jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{child_user_id}}\",\n  \"fullName\": \"Rizky Anak\",\n  \"dateOfBirth\": \"2015-08-20\",\n  \"pin\": \"1234\",\n  \"childAccountNumber\": \"CHILD-0001\",\n  \"createdByParentId\": \"{{parent_profile_id}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/children", "host": ["{{base_url}}"], "path": ["children"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create child profile success', function () { pm.response.to.have.status(201); });",
              "try { const json = pm.response.json(); if (json.data && json.data.id) pm.environment.set('child_profile_id', json.data.id); } catch(e){}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 - Link Family (parent_profile_id + child_profile_id)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{parent_jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parentProfileId\": \"{{parent_profile_id}}\",\n  \"childProfileId\": \"{{child_profile_id}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/family-links", "host": ["{{base_url}}"], "path": ["family-links"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('link family success', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07 - Create Child Account (optional)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{parent_jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"childProfileId\": \"{{child_profile_id}}\",\n  \"childAccountNumber\": \"CHILD-ACC-0001\",\n  \"initialBalanceSen\": 0\n}"
        },
        "url": { "raw": "{{base_url}}/child-accounts", "host": ["{{base_url}}"], "path": ["child-accounts"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create child account success', function () { pm.response.to.have.status(201); });",
              "try { const json = pm.response.json(); if (json.data && json.data.id) pm.environment.set('child_account_id', json.data.id); } catch(e){}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001" },
    { "key": "parent_email", "value": "budi@example.com" },
    { "key": "parent_password", "value": "ParentPass123!" },
    { "key": "child_email", "value": "rizky@example.com" },
    { "key": "child_password", "value": "ChildPass123!" },
    { "key": "parent_jwt", "value": "" },
    { "key": "parent_user_id", "value": "" },
    { "key": "parent_profile_id", "value": "" },
    { "key": "child_user_id", "value": "" },
    { "key": "child_profile_id", "value": "" },
    { "key": "child_account_id", "value": "" }
  ]
}