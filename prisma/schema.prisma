// =============================================
// BYOND KIDS — Prisma Schema
// PostgreSQL via Supabase
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================
// ENUMS
// =============================================

enum Role {
  SUPER_ADMIN
  PARENT
  CHILD
}

enum AccountType {
  SAVINGS        // tabungan utama
  CHILD_SAVINGS  // tabungan anak (sub-account)
}

enum TransactionType {
  CREDIT         // uang masuk
  DEBIT          // uang keluar
}

enum TransactionSource {
  TOP_UP_FROM_PARENT   // ortu transfer ke anak
  CHORE_REWARD         // reward chores disetujui
  POCKET_ALLOCATE      // anak alokasikan ke pocket
  POCKET_DEALLOCATE    // anak tarik balik dari pocket
  VOUCHER_PURCHASE     // beli voucher
  INFAQ                // sedekah
  ADJUSTMENT           // koreksi admin
}

enum ChoreStatus {
  DRAFT            // baru dibuat ortu, belum aktif
  ACTIVE           // sudah aktif, anak bisa lihat
  SUBMITTED        // anak sudah submit bukti
  PENDING_REVIEW   // menunggu review ortu
  APPROVED         // ortu setuju, reward cair
  REJECTED         // ortu tolak, bisa resubmit
  REVISION_NEEDED  // butuh perbaikan (sama dgn rejected tapi eksplisit)
  EXPIRED          // deadline lewat tanpa submission
  CANCELLED        // dibatalkan ortu (hanya jika DRAFT/ACTIVE)
}

enum PocketCategory {
  JAJAN     // uang saku harian
  HAJI      // tabungan haji
  QURBAN    // tabungan qurban
  INFAQ     // alokasi sedekah
  CUSTOM    // bebas diberi nama anak
}

enum SpendingLimitPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum InfaqInstitution {
  BSI_MASLAHAT
  BAZNAS
  LAZISNU
  LAZISMU
  OTHER
}

// =============================================
// TABEL UTAMA
// =============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parentProfile ParentProfile?
  childProfile  ChildProfile?
  auditLogs     AuditLog[]

  @@map("users")
}

model ParentProfile {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  fullName         String  @map("full_name")
  nik              String  @unique
  dateOfBirth      DateTime @map("date_of_birth")
  // Nomor rekening BSI orang tua (source of fund)
  // Dalam prototype: dummy, nanti hook ke core banking BSI
  bsiAccountNumber String  @map("bsi_account_number")
  // Saldo dummy untuk prototype (dalam rupiah, stored as integer paise/sen)
  dummyBalance     BigInt  @default(5000000000) @map("dummy_balance") // Rp 5.000.000 default

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyLinks  FamilyLink[]
  choresCreated Chore[]      @relation("ChoreCreator")
  spendingLimitsSet SpendingLimit[] @relation("LimitSetBy")

  @@map("parent_profiles")
}

model ChildProfile {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  fullName      String    @map("full_name")
  dateOfBirth   DateTime  @map("date_of_birth")
  pinHash       String    @map("pin_hash")
  deviceId      String?   @map("device_id")    // device binding
  createdByParentId String @map("created_by_parent_id")
  isActive      Boolean   @default(true) @map("is_active")
  // Nomor rekening anak (sub-account dari rekening ortu)
  // Dalam prototype: dummy, nanti hook ke core banking
  childAccountNumber String @map("child_account_number")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyLinks     FamilyLink[]
  account         ChildAccount?
  choresAssigned  Chore[]         @relation("ChoreAssignee")
  spendingLimits  SpendingLimit[] @relation("ChildLimits")
  infaqLogs       InfaqLog[]
  voucherRedemptions VoucherRedemption[]

  @@map("child_profiles")
}

model FamilyLink {
  id              String   @id @default(uuid())
  parentProfileId String   @map("parent_profile_id")
  childProfileId  String   @map("child_profile_id")
  linkedAt        DateTime @default(now()) @map("linked_at")

  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  childProfile  ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, childProfileId])
  @@map("family_links")
}

// =============================================
// REKENING & SALDO ANAK
// =============================================

// Rekening utama anak — sumber saldo sebelum dibagi ke pocket
model ChildAccount {
  id             String   @id @default(uuid())
  childProfileId String   @unique @map("child_profile_id")
  // Saldo dalam satuan sen/paise (integer) untuk menghindari floating point
  // Rp 10.000 = 1000000 (dalam sen)
  balance        BigInt   @default(0)
  currency       String   @default("IDR")
  updatedAt      DateTime @updatedAt @map("updated_at")

  childProfile ChildProfile   @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  ledger       AccountLedger[]
  pockets      Pocket[]

  @@map("child_accounts")
}

// Ledger rekening anak — INSERT ONLY, tidak ada UPDATE/DELETE
// Setiap perubahan saldo = 1 baris baru di sini
model AccountLedger {
  id              String            @id @default(uuid())
  accountId       String            @map("account_id")
  type            TransactionType
  source          TransactionSource
  amount          BigInt            // selalu positif, type yg menentukan arah
  balanceAfter    BigInt            @map("balance_after")
  referenceId     String?           @map("reference_id")  // id chore/voucher/infaq terkait
  triggeredBy     String            @map("triggered_by")  // user_id yang trigger
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")

  account ChildAccount @relation(fields: [accountId], references: [id])

  @@map("account_ledger")
}

// =============================================
// POCKET — Alokasi Saldo Anak
// =============================================

// Pocket adalah partisi virtual dari saldo rekening anak
// Total balance semua pocket tidak boleh melebihi saldo rekening anak
model Pocket {
  id             String         @id @default(uuid())
  accountId      String         @map("account_id")
  name           String
  category       PocketCategory
  balance        BigInt         @default(0)   // saldo teralokasi di pocket ini
  targetAmount   BigInt?        @map("target_amount")  // untuk goal saving
  intentionText  String?        @map("intention_text") // fitur "niat" syariah
  emoji          String?        @default("💰")
  deadline       DateTime?
  isActive       Boolean        @default(true) @map("is_active")
  isGoalCompleted Boolean       @default(false) @map("is_goal_completed")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  account      ChildAccount   @relation(fields: [accountId], references: [id])
  ledger       PocketLedger[]
  chores       Chore[]        @relation("ChoreTargetPocket")

  @@map("pockets")
}

// Ledger pocket — INSERT ONLY
model PocketLedger {
  id           String            @id @default(uuid())
  pocketId     String            @map("pocket_id")
  type         TransactionType
  source       TransactionSource
  amount       BigInt
  balanceAfter BigInt            @map("balance_after")
  referenceId  String?           @map("reference_id")
  triggeredBy  String            @map("triggered_by")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")

  pocket Pocket @relation(fields: [pocketId], references: [id])

  @@map("pocket_ledger")
}

// =============================================
// CHORES — Tugas & Reward
// =============================================

model Chore {
  id              String      @id @default(uuid())
  createdById     String      @map("created_by_id")        // parent_profile_id
  assignedToId    String      @map("assigned_to_id")       // child_profile_id
  targetPocketId  String?     @map("target_pocket_id")     // pocket tujuan reward
  title           String
  description     String?
  category        String      // Akademik | Hafalan | Pekerjaan Rumah | Ibadah | Lainnya
  rewardAmount    BigInt      @map("reward_amount")         // dalam sen
  deadline        DateTime
  status          ChoreStatus @default(DRAFT)
  rejectionNote   String?     @map("rejection_note")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  createdBy    ParentProfile    @relation("ChoreCreator", fields: [createdById], references: [id])
  assignedTo   ChildProfile     @relation("ChoreAssignee", fields: [assignedToId], references: [id])
  targetPocket Pocket?          @relation("ChoreTargetPocket", fields: [targetPocketId], references: [id])
  submissions  ChoreSubmission[]

  @@map("chores")
}

model ChoreSubmission {
  id           String    @id @default(uuid())
  choreId      String    @map("chore_id")
  mediaUrl     String?   @map("media_url")    // URL foto bukti di Supabase Storage
  notes        String?
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewerNote String?   @map("reviewer_note")
  attempt      Int       @default(1)          // berapa kali submit (max 2)

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@map("chore_submissions")
}

// =============================================
// SPENDING LIMIT
// =============================================

model SpendingLimit {
  id             String              @id @default(uuid())
  childProfileId String              @map("child_profile_id")
  setByParentId  String              @map("set_by_parent_id")
  period         SpendingLimitPeriod
  limitAmount    BigInt              @map("limit_amount")  // dalam sen
  excludeInfaq   Boolean             @default(true) @map("exclude_infaq")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  childProfile ChildProfile  @relation("ChildLimits", fields: [childProfileId], references: [id])
  setByParent  ParentProfile @relation("LimitSetBy", fields: [setByParentId], references: [id])

  @@unique([childProfileId, period]) // 1 limit per periode per anak
  @@map("spending_limits")
}

// =============================================
// INFAQ / SEDEKAH
// =============================================

model InfaqLog {
  id             String           @id @default(uuid())
  childProfileId String           @map("child_profile_id")
  institution    InfaqInstitution
  institutionName String?         @map("institution_name") // jika OTHER
  amount         BigInt           // dalam sen
  sourcePocketId String?          @map("source_pocket_id") // dari pocket mana
  createdAt      DateTime         @default(now()) @map("created_at")

  childProfile ChildProfile @relation(fields: [childProfileId], references: [id])

  @@map("infaq_logs")
}

// =============================================
// VOUCHER MARKETPLACE
// =============================================

model VoucherCatalog {
  id          String  @id @default(uuid())
  name        String
  provider    String  // Shopee, Mobile Legends, Free Fire, dll
  category    String  // Belanja Online | Gaming | Lainnya
  price       BigInt  // dalam sen
  description String?
  imageUrl    String? @map("image_url")
  mockCode    String  @map("mock_code") // kode voucher dummy untuk demo
  isActive    Boolean @default(true) @map("is_active")

  redemptions VoucherRedemption[]

  @@map("voucher_catalog")
}

model VoucherRedemption {
  id             String   @id @default(uuid())
  childProfileId String   @map("child_profile_id")
  voucherId      String   @map("voucher_id")
  sourcePocketId String?  @map("source_pocket_id")
  amount         BigInt
  mockCodeIssued String   @map("mock_code_issued")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  childProfile ChildProfile   @relation(fields: [childProfileId], references: [id])
  voucher      VoucherCatalog @relation(fields: [voucherId], references: [id])

  @@map("voucher_redemptions")
}

// =============================================
// AUDIT LOG — Wajib untuk Banking
// =============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // CREATE_CHORE | APPROVE_CHORE | TOP_UP | etc.
  entityType String   @map("entity_type") // Chore | Pocket | Account | etc.
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
