
PORT=UR PORT BACKEND
# NODE_ENV=development


# Pooler (transaction mode) — untuk query normal
DATABASE_URL="SUPABASE"

# Direct connection — untuk migrate / prisma studio
DIRECT_URL="SUPABASE"

# =============================================
# JWT — buat nilai random minimal 32 karakter
# Gunakan: openssl rand -hex 64
# =============================================

JWT_SECRET="ganti_dengan_string_random_min_64_karakter_jangan_commit"
JWT_EXPIRES_IN="8m"
JWT_REFRESH_SECRET="ganti_dengan_string_random_lain_min_64_karakter"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================
# Supabase — untuk Storage (foto bukti chore)
# Ambil dari: Project → Settings → API
# =============================================

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="UR SUPABASE ANON KEY."
SUPABASE_SERVICE_ROLE_KEY="UR SERVICE ROLE KEY"
SUPABASE_STORAGE_BUCKET="chore-submissions"

# =============================================
# CORS — origin frontend yang diizinkan
# =============================================

ALLOWED_ORIGINS=URL_FRONTEND_LIVE

# =============================================
# CAPTCHA — hCaptcha (https://dashboard.hcaptcha.com)
# Set CAPTCHA_ENABLED=false untuk skip di development
# =============================================

CAPTCHA_ENABLED=false
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# =============================================
# Rate Limiting
# =============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
BCRYPT_SALT_ROUNDS=12

# =============================================
# Email / SMTP — untuk kirim reset password & username reminder
#
# Dev: kosongkan SMTP_HOST → Nodemailer akan pakai Ethereal (test email).
#      Preview URL akan muncul di console log.
#
# Prod Gmail: aktifkan 2FA → buat App Password di myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=noreply@domainmu.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   (App Password Gmail)
#
# Prod SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxx
#
# Prod Resend (recommended — generous free tier):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxx
# =============================================

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Byond Kids <noreply@byondkids.id>"

# URL frontend — digunakan di link reset password yang dikirim via email
APP_URL=http://localhost:3000

# Berapa lama reset token valid (ms) — default 900000 = 15 menit
PASSWORD_RESET_EXPIRES_MS=900000